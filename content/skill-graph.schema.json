{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "team4/skill-graph.schema.json",
  "title": "Skill graph for one learning goal domain",
  "type": "object",
  "required": ["id", "version", "title", "goalKeywords", "skills"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "goalKeywords": {
      "description": "Words the onboarding step matches against the learner's goal to pick this domain.",
      "type": "array", "items": { "type": "string" }, "minItems": 1
    },
    "skills": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "targetLevel", "estHours", "prereqs", "resources"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "targetLevel": {
            "description": "Mastery (0-1) the goal needs. Gap = targetLevel - learner mastery.",
            "type": "number", "minimum": 0, "maximum": 1
          },
          "estHours": { "description": "Study hours to go from zero to targetLevel.", "type": "number", "exclusiveMinimum": 0 },
          "prereqs": { "type": "array", "items": { "type": "string" } },
          "resources": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["title", "url", "kind"],
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string" },
                "url": { "type": "string", "pattern": "^https://" },
                "kind": { "enum": ["course", "docs", "video", "practice", "book"] }
              }
            }
          },
          "quiz": {
            "description": "Hand-written diagnostic questions. Llama may add more at runtime.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["q", "options", "answer"],
              "additionalProperties": false,
              "properties": {
                "q": { "type": "string" },
                "options": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
                "answer": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
