<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the learner's progress on this phone. Nothing goes to cloud backup or to another device
     during a phone-to-phone transfer (allowBackup="false" in the manifest covers Android 11 and lower). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
